<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/set_library">

    <org.oxycblt.auxio.settings.ui.WrappedDialogPreference
        app:key="@string/set_key_music_dirs"
        app:summary="@string/set_locations_desc"
        app:title="@string/set_locations" />

    <Preference
        app:key="@string/set_key_reindex"
        app:summary="@string/set_reindex_desc"
        app:title="@string/set_reindex" />

    <Preference
        app:key="@string/set_key_rescan"
        app:summary="@string/set_rescan_desc"
        app:title="@string/set_rescan" />

    <PreferenceCategory app:title="@string/set_organize">

        <EditTextPreference
            app:defaultValue="@string/set_organize_folder_format_default"
            app:dialogMessage="@string/set_organize_folder_format_desc"
            app:key="@string/set_key_organize_folder_format"
            app:summary="@string/set_organize_folder_format_desc"
            app:title="@string/set_organize_folder_format" />

        <EditTextPreference
            app:defaultValue="@string/set_organize_file_format_default"
            app:dialogMessage="@string/set_organize_file_format_desc"
            app:key="@string/set_key_organize_file_format"
            app:summary="@string/set_organize_file_format_desc"
            app:title="@string/set_organize_file_format" />

        <Preference
            app:key="@string/set_key_organize"
            app:summary="@string/set_organize_desc"
            app:title="@string/set_organize" />

    </PreferenceCategory>

</PreferenceScreen>
