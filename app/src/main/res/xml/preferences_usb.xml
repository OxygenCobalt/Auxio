<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/set_usb">

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="@string/set_key_usb_enabled"
        app:summary="@string/set_usb_enabled_desc"
        app:title="@string/set_usb_enabled" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="@string/set_key_usb_bit_perfect"
        app:summary="@string/set_usb_bit_perfect_desc"
        app:title="@string/set_usb_bit_perfect" />

    <SeekBarPreference
        android:max="10"
        app:defaultValue="5"
        app:key="@string/set_key_usb_volume_step_percent"
        app:min="1"
        app:showSeekBarValue="true"
        app:summary="@string/set_usb_volume_step_percent_desc"
        app:title="@string/set_usb_volume_step_percent" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="@string/set_key_usb_abx_test"
        app:summary="@string/set_usb_abx_test_desc"
        app:title="@string/set_usb_abx_test" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="@string/set_key_usb_manual_release_control"
        app:summary="@string/set_usb_manual_release_control_desc"
        app:title="@string/set_usb_manual_release_control" />

    <Preference
        app:key="@string/set_key_usb_device"
        app:selectable="false"
        app:title="@string/set_usb_device" />

    <Preference
        app:key="@string/set_key_usb_retry"
        app:summary="@string/set_usb_retry_desc"
        app:title="@string/set_usb_retry" />

    <Preference
        app:key="@string/set_key_usb_capabilities"
        app:summary="@string/set_usb_capabilities_desc"
        app:title="@string/set_usb_capabilities" />

    <Preference
        app:key="@string/set_key_usb_pipeline"
        app:summary="@string/set_usb_pipeline_desc"
        app:title="@string/set_usb_pipeline" />

    <PreferenceCategory
        app:key="@string/set_key_usb_controls_category"
        app:title="@string/set_usb_controls_category" />

    <PreferenceCategory
        app:key="@string/set_key_usb_log_category"
        app:title="@string/set_usb_log_category" />

</PreferenceScreen>
